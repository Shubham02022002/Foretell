generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MarketStatus {
  DRAFT
  OPEN
  CLOSED
  RESOLVED
  VOID
}

enum Outcome {
  YES
  NO
}

enum OrderAction {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
  EXPIRED
}

enum LedgerType {
  INITIAL_CREDIT
  TRADE_BUY
  TRADE_SELL
  SETTLEMENT_PAYOUT
  REFUND
  ADMIN_ADJUSTMENT
  // Retained so pre-order-book ledger history remains a valid enum member.
  // The application no longer writes these values.
  BET_STAKE
  BET_PAYOUT
  POSITION_SALE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  wallet              Wallet?
  orders              Order[]
  positions           Position[]
  watchlist           Watchlist[]
  comments            Comment[]
  notifications       Notification[]
  ledgerEntries       LedgerEntry[]
  passwordResetTokens PasswordResetToken[]
  resolutions         MarketResolution[]   @relation("AdminResolutions")
  auditEvents         AuditEvent[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Market {
  id            String            @id @default(uuid())
  slug          String            @unique
  question      String
  description   String?
  rules         String?
  category      String
  status        MarketStatus      @default(DRAFT)
  closesAt      DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        Order[]
  trades        Trade[]
  positions     Position[]
  watchlist     Watchlist[]
  comments      Comment[]
  notifications Notification[]
  resolution    MarketResolution?
  ledgers       LedgerEntry[]
  auditEvents   AuditEvent[]
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  marketId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  marketId  String?
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  marketId  String
  body      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, createdAt])
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  marketId       String
  outcome        Outcome
  action         OrderAction
  type           OrderType   @default(LIMIT)
  price          Int
  quantity       Int
  filledQuantity Int         @default(0)
  status         OrderStatus @default(OPEN)
  idempotencyKey String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  market     Market  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  makerTrades Trade[] @relation("MakerTrades")
  takerTrades Trade[] @relation("TakerTrades")

  @@unique([userId, idempotencyKey])
  @@index([marketId, status, createdAt])
  @@index([marketId, status, price])
  @@index([userId, status, createdAt])
}

model Trade {
  id           String   @id @default(uuid())
  marketId     String
  makerOrderId String
  takerOrderId String
  makerUserId  String
  takerUserId  String
  yesPrice     Int
  quantity     Int
  createdAt    DateTime @default(now())

  market     Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  makerOrder Order  @relation("MakerTrades", fields: [makerOrderId], references: [id], onDelete: Restrict)
  takerOrder Order  @relation("TakerTrades", fields: [takerOrderId], references: [id], onDelete: Restrict)

  @@index([marketId, createdAt])
  @@index([makerOrderId])
  @@index([takerOrderId])
}

model Position {
  id         String @id @default(uuid())
  userId     String
  marketId   String
  yesShares  Int    @default(0)
  noShares   Int    @default(0)
  yesReserved Int   @default(0)
  noReserved Int    @default(0)
  yesCost    Int    @default(0)
  noCost     Int    @default(0)
  realized   Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([userId, marketId])
  @@index([marketId])
}

model LedgerEntry {
  id       String  @id @default(uuid())
  userId   String
  marketId String?
  orderId  String?
  tradeId  String?

  amount    Int
  type      LedgerType
  createdAt DateTime   @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([marketId])
}

model MarketResolution {
  id          String   @id @default(uuid())
  marketId    String   @unique
  outcome     Outcome
  evidenceUrl String?
  notes       String?
  resolvedBy  String
  resolvedAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  admin  User   @relation("AdminResolutions", fields: [resolvedBy], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  marketId  String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
